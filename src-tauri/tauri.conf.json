{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Webtop Manager",
  "version": "1.0.0",
  "identifier": "com.cue.webtop-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Webtop Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["assets/*"],
    "category": "Utility",
    "shortDescription": "Manage local Webtop desktop environments",
    "longDescription": "A secure desktop manager for persistent LinuxServer Webtop environments and FRP publication."
  }
}
